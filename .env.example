NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# Local development only. Never expose this database beyond loopback.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgres://deepfish:replace-with-local-password@127.0.0.1:5432/deepfish
# Integration tests create/drop only randomized test schemas.
TEST_DATABASE_URL=postgres://deepfish:replace-with-local-password@127.0.0.1:5432/deepfish
ALLOWED_ORIGIN=http://localhost:8080
MERCHANT_INITIAL_TREASURY=10000
POPULATION_TICK_SECONDS=60
MARKET_TICK_SECONDS=60
CATCH_SESSION_TTL_SECONDS=300
CATCH_MAX_SHOTS=30
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Public account IDs only. Deployed Testnet contract; no credentials here.
# API consumes NEAR_CONTRACT_ID; other IDs are operator checklist values, not signing credentials.
NEAR_CONTRACT_ID=deepfish-contract.testnet
NEAR_OWNER_ID=deepfish-owner.testnet
NEAR_SELLER_ID=
NEAR_BUYER_ID=
# Testnet signer for auto-mint/orders; key read from ~/.near-credentials/testnet/<id>.json
NEAR_MERCHANT_OWNER_ID=
AUTO_MINT_ENABLED=false
